<resources>
    <!-- Unlock animation -->
    <string name="pref_unlock_animation_style_title">Unlock animation</string>
    <string name="unlock_animation_style_none">None (system default)</string>
    <string name="unlock_animation_style_ring">Ring reveal</string>

    <!-- Labels for pref_unlock_animation_style, in the same order as
         unlock_animation_style_values. -->
    <string-array name="unlock_animation_style_entries">
        <item>@string/unlock_animation_style_none</item>
        <item>@string/unlock_animation_style_ring</item>
    </string-array>

    <!-- Stored values for pref_unlock_animation_style, must match the ids in
         com.android.quickstep.unlock.UnlockAnimationStyles. -->
    <string-array name="unlock_animation_style_values" translatable="false">
        <item>none</item>
        <item>ring</item>
    </string-array>
</resources>
